{
  "spec_version": "2",
  "id": "template-cloudflare-cache-purge",
  "name": "Cloudflare Cache Purge",
  "created_at": "2026-08-10T00:00:00Z",
  "updated_at": "2026-08-10T00:00:00Z",
  "enabled": false,
  "requires": {
    "packs": [
      {
        "id": "cloudflare",
        "version": ">=1.2.0, <2.0.0",
        "reason": "purges the CDN cache after a deploy",
        "resolved_version": "1.3.1"
      }
    ],
    "tools": ["cloudflare_purge_cache"]
  },
  "flow": {
    "nodes": [
      {
        "id": "entry",
        "node_type": "entry",
        "data": { "schedule_type": "manual" },
        "position": [0.0, 0.0]
      },
      {
        "id": "purge",
        "node_type": "tool",
        "data": {
          "tool_name": "cloudflare_purge_cache",
          "args": { "zone": "{{zone_id}}" },
          "output_var": "purge_result"
        },
        "position": [250.0, 0.0]
      }
    ],
    "edges": [
      { "id": "e0", "source": "entry", "target": "purge", "source_handle": "ok" }
    ]
  }
}
